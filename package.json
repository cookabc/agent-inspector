  "description": "把 ZCode / Codex / Claude Code / Cursor / DeepSeek Harness 的落盘目录摊开看清楚：每一类占多少、删了会怎样，然后决定清掉哪些",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookabc/agent-inspector.git"
  },
  "keywords": [
    "zcode",
    "codex",
    "claude-code",
    "cursor",
    "deepseek",
    "coding-agent",
    "disk-usage",
    "cleanup",
    "audit",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.mjs",
    "test": "node --experimental-sqlite --test",
    "check": "node scripts/check.mjs",
    "test:ui": "node scripts/ui-regression.mjs",
    "test:e2e": "playwright test"
  },
  "author": "cookabc",
  "devDependencies": {
    "@playwright/test": "1.64.1"
